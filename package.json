{
  "name": "nextrep",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "android": "expo run:android --device",
    "prebuild": "expo prebuild --no-install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test src/features/squat/*.test.ts src/features/tracking/*.test.ts src/features/workout/*.test.ts src/features/progression/*.test.ts src/features/location/*.test.ts src/features/challenge/*.test.ts src/features/diagnostics/*.test.ts src/navigation/*.test.ts src/theme/*.test.ts",
    "replay": "tsx src/features/squat/replay.ts",
    "check:bundle": "expo export --platform ios --platform android",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "0.4.2",
    "@maplibre/maplibre-react-native": "10.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "54.0.37",
    "expo-dev-client": "6.0.21",
    "expo-device": "~7.0.3",
    "expo-font": "~14.0.12",
    "expo-location": "~19.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mediapipe": "0.6.0",
    "react-native-safe-area-context": "5.6.0",
    "react-native-vision-camera": "4.7.3",
    "react-native-worklets-core": "1.6.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
    "@babel/plugin-proposal-optional-chaining": "7.21.0",
    "@babel/plugin-transform-template-literals": "7.27.1",
    "@types/react": "19.1.10",
    "babel-preset-expo": "54.0.10",
    "eslint": "9.39.1",
    "eslint-config-expo": "10.0.0",
    "patch-package": "^8.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
