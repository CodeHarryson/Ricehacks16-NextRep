# Required on physical devices. Replace with the development computer's current LAN URL.
EXPO_PUBLIC_API_URL=
# iOS Simulator loopback.
EXPO_PUBLIC_SIMULATOR_API_URL=http://127.0.0.1:3000
# Android Emulator host-machine alias. If omitted, SIMULATOR_API_URL is used.
EXPO_PUBLIC_ANDROID_EMULATOR_API_URL=http://10.0.2.2:3000
# Required for preview/production builds: the deployed https API URL (placeholders are rejected).
EXPO_PUBLIC_PRODUCTION_API_URL=
EXPO_PUBLIC_MAPTILER_API_KEY=
EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/base-v4/style.json
